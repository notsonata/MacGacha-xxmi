# SRMI cursor/window coordinate contract fix
# Base: XXMI-Libs-Package a7847eae82aaac32175c9a7d199673d5c9323bcd (XXMI Libraries v1.2.2)
# Apply from the XXMI Libs package root after patches 0001-0007 with:
#   patch -p1 --fuzz=0 < 0009-srmi-cursor-coordinate-contract.patch
# Patch 0008 targets the SRMI payload shader, not this DLL source tree.
#
# CURSOR_X/CURSOR_Y used the WINDOW_WIDTH/HEIGHT heuristic, which can return
# RES_WIDTH/RT_WIDTH/gFallback instead of the client width/height. A cursor at
# the client left/top edge also fell through to CURSOR_SCREEN_X/Y, i.e. desktop
# pixels divided by that unrelated size. Failed GetCursorInfo, GetClientRect
# and ScreenToClient calls were ignored, so zeroed or untranslated values could
# be reported as real client coordinates.
#
# This patch records query attempts and validity explicitly and normalizes only
# when the cursor screen position and its client conversion succeeded and the
# client rect has a positive width/height. The actual client size is used as-is
# (also below 640x480); minimized/zero-sized windows and failed APIs yield 0
# instead of leaking desktop or render-target pixels. A valid zero or a
# negative out-of-window client coordinate is returned unchanged.
# CURSOR_SCREEN_X/Y stay raw screen pixels; CURSOR_WINDOW_X/Y stay raw client
# pixels. For a healthy window (positive client rect, cursor inside) the values
# are unchanged, because the old heuristic already preferred the client rect
# first. WINDOW_WIDTH/HEIGHT and the rest of the heuristic chain are untouched.
#
# Queries remain cached per command list, including failed and zero-sized
# results, but validity is explicit: a cached failure or zero-sized rect is
# never used as client coordinates. Each new command list retries once.
#
# CommandListState gains five query/validity bools, so this is an ABI change
# for that struct: rebuild every translation unit and do not mix objects built
# from the old layout.
#
# This fixes a source-proven coordinate-contract bug. It does not by itself
# prove any specific mod symptom (for example page switching in a slider UI or
# interactions between two creators), which needs separate live evidence.
#
--- a/DirectX11/CommandList.h
+++ b/DirectX11/CommandList.h
@@ -83,6 +83,16 @@
 	ID3D11ShaderResourceView *cursor_mask_view;
 	ID3D11ShaderResourceView *cursor_color_view;
 	RECT window_rect;
+	// These record whether the cursor/window queries above were attempted and
+	// whether they actually succeeded, instead of inferring it from the returned
+	// values. A zero client edge, a minimized window or a failed
+	// GetCursorInfo/ScreenToClient call must not be reported as a real client
+	// position, and must never be replaced with render target or desktop pixels.
+	bool cursor_info_queried;
+	bool cursor_info_valid;
+	bool cursor_window_coords_valid;
+	bool window_rect_queried;
+	bool window_rect_valid;
 
 	int recursion;
 	int extra_indent;
