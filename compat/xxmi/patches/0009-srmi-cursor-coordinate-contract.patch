+// Returns the actual client size in pixels. A positive rect is used as-is,
+// including sizes below the 640x480 WINDOW_WIDTH/HEIGHT heuristic, because
+// normalized cursor coordinates must stay in the client pixel domain.
+// Zero-sized (minimized/hidden) rects and failed queries are unusable.
+static bool GetClientExtent(CommandListState *state, float *width, float *height)
+{
+	if (!UpdateWindowInfo(state))
+		return false;
 
+	float w = (float)(state->window_rect.right - state->window_rect.left);
+	float h = (float)(state->window_rect.bottom - state->window_rect.top);
+	if (w <= 0.0f || h <= 0.0f)
+		return false;
+
+	*width = w;
+	*height = h;
+	return true;
+}
