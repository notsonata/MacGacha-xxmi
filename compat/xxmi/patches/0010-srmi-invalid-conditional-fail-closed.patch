 	return expression.optimise(device);
 }
 
@@ -9533,6 +9560,16 @@
 {
 	if ((post && !post_finalised) || (!post && !pre_finalised)) {
 		LogOverlayW(LOG_WARNING, L"Statement \"if\" missing \"endif\":\n - \"%ls\"\n", ini_line.c_str());
+		return true;
