 {
+	if (!expression_valid) {
+		// Never evaluate a partially parsed condition, and drop every
+		// command in both branches before they can be optimised or run.
+		true_commands_pre->clear();
+		true_commands_post->clear();
+		false_commands_pre->clear();
+		false_commands_post->clear();
+		return false;
+	}
