--- a/DirectX11/ResourceReleaseQueue.h
+++ b/DirectX11/ResourceReleaseQueue.h
@@ -0,0 +1,28 @@
+#pragma once
+
+#include <atomic>
+
+static_assert(ATOMIC_POINTER_LOCK_FREE == 2,
+              "SRMI callback queue requires always-lock-free pointer atomics");
+
+struct SrmiIntrusiveMpscStackNode {
+	std::atomic<SrmiIntrusiveMpscStackNode *> next{nullptr};
+};
+
+class SrmiIntrusiveMpscStack {
+public:
+	void push(SrmiIntrusiveMpscStackNode *node) noexcept {
+		SrmiIntrusiveMpscStackNode *head = head_.load(std::memory_order_relaxed);
+		do {
+			node->next.store(head, std::memory_order_relaxed);
+		} while (!head_.compare_exchange_weak(
+			head, node, std::memory_order_release, std::memory_order_relaxed));
+	}
+
+	SrmiIntrusiveMpscStackNode *take_all() noexcept {
+		return head_.exchange(nullptr, std::memory_order_acquire);
+	}
+
+private:
+	std::atomic<SrmiIntrusiveMpscStackNode *> head_{nullptr};
+};
