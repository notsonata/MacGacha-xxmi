@@ -1286,12 +1286,64 @@
 DEFINE_GUID(ResourceReleaseTrackerGuid,
 0x4a40bf2f, 0x6358, 0x470f, 0xba, 0xa, 0x66, 0x2e, 0x3e, 0x2d, 0x8c, 0xd3);
 
+static SrmiIntrusiveMpscStack pending_resource_releases;
+static const size_t resource_release_tracker_bucket_count = 4096;
+static ResourceReleaseTracker *resource_release_tracker_buckets[
+	resource_release_tracker_bucket_count] = {};
+
+static size_t resource_release_tracker_bucket(ID3D11Resource *resource)
+{
+	return (reinterpret_cast<uintptr_t>(resource) >> 4) &
+		(resource_release_tracker_bucket_count - 1);
+}
+
+static ResourceReleaseTracker **find_resource_release_tracker_link(
+	ID3D11Resource *resource)
+{
+	ResourceReleaseTracker **link =
+		&resource_release_tracker_buckets[resource_release_tracker_bucket(resource)];
+	while (*link && (*link)->GetResource() != resource)
+		link = &(*link)->GetRegistryNext();
+	return link;
+}
+
+void RegisterResourceReleaseTrackerLocked(ResourceReleaseTracker *tracker)
+{
+	ResourceReleaseTracker **link = find_resource_release_tracker_link(
+		tracker->GetResource());
+	if (*link) {
+		ResourceReleaseTracker *previous = *link;
+		tracker->SetRegistryNext(previous->GetRegistryNext());
+		previous->SetRegistryNext(nullptr);
+	} else {
+		tracker->SetRegistryNext(nullptr);
+	}
+	*link = tracker;
+}
+
+void DrainResourceReleaseTrackersLocked()
+{
+	SrmiIntrusiveMpscStackNode *node = pending_resource_releases.take_all();
+	while (node) {
+		SrmiIntrusiveMpscStackNode *next =
+			node->next.load(std::memory_order_relaxed);
+		ResourceReleaseTracker *tracker =
+			static_cast<ResourceReleaseTracker *>(node);
+		ResourceReleaseTracker **link =
+			find_resource_release_tracker_link(tracker->GetResource());
+		if (*link == tracker) {
+			*link = tracker->GetRegistryNext();
+			G->mResources.erase(tracker->GetResource());
+		}
+		delete tracker;
+		node = next;
+	}
+}
+
 ResourceReleaseTracker::ResourceReleaseTracker(ID3D11Resource *resource) :
-	resource(resource)
-{
-	ref = 0;
-	HRESULT hr = resource->SetPrivateDataInterface(ResourceReleaseTrackerGuid, this);
-	// LogDebug("ResourceReleaseTracker %p tracking %p: 0x%x\n", this, resource, hr);
+	ref(0), resource(resource), registry_next(nullptr)
+{
+	resource->SetPrivateDataInterface(ResourceReleaseTrackerGuid, this);
 }
 
