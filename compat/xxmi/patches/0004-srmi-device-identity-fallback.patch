--- /dev/null
+++ b/DirectX11/D3D11DeviceIdentity.h
@@ -0,0 +1,82 @@
+#pragma once
+
+#include <d3d11.h>
+#include <dxgi.h>
+
+static const IID SRMI_IID_IUNKNOWN =
+    {0x00000000, 0x0000, 0x0000, {0xc0, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x46}};
+static const IID SRMI_IID_ID3D11DEVICE =
+    {0xdb6f6ddb, 0xac77, 0x4e88, {0x82, 0x53, 0x81, 0x9d, 0xf9, 0xbb, 0xf1, 0x40}};
+
+// Query canonical IUnknown first. If a backend rejects it, consistently use
+// the queried ID3D11Device interface as a compatibility key on both sides.
+static inline HRESULT query_d3d11_device_identity(
+    IUnknown *source,
+    IUnknown **key,
+    HRESULT *iunknown_result,
+    HRESULT *device_result,
+    BOOL *used_device_fallback)
+{
+    if (!source || !key || !iunknown_result || !device_result || !used_device_fallback)
+        return E_POINTER;
+
+    *key = NULL;
+    *iunknown_result = E_PENDING;
+    *device_result = E_PENDING;
+    *used_device_fallback = FALSE;
+#ifdef __cplusplus
+    HRESULT result = source->QueryInterface(SRMI_IID_IUNKNOWN, (void **)key);
+#else
+    HRESULT result = source->lpVtbl->QueryInterface(source, &SRMI_IID_IUNKNOWN, (void **)key);
+#endif
+    *iunknown_result = result;
+    if (SUCCEEDED(result) && *key)
+        return result;
+    // Ignore any pointer a broken implementation writes when returning failure.
+    *key = NULL;
+
+    ID3D11Device *device = NULL;
+#ifdef __cplusplus
+    *device_result = source->QueryInterface(SRMI_IID_ID3D11DEVICE, (void **)&device);
+#else
+    *device_result = source->lpVtbl->QueryInterface(source, &SRMI_IID_ID3D11DEVICE,
+                                                     (void **)&device);
+#endif
+    if (SUCCEEDED(*device_result) && device) {
+#ifdef __cplusplus
+        *key = static_cast<IUnknown *>(device);
+#else
+        *key = (IUnknown *)device;
+#endif
+        *used_device_fallback = TRUE;
+        return *device_result;
+    }
+    *key = NULL;
+    return FAILED(*device_result) ? *device_result : E_NOINTERFACE;
+}
+
+static inline HRESULT get_hacker_device_private_data(
+    IDXGIObject *object,
+    const IID *key,
+    void **value)
+{
+    if (!object || !key || !value)
+        return E_POINTER;
+
+    *value = NULL;
+    UINT size = sizeof(*value);
+#ifdef __cplusplus
+    HRESULT result = object->GetPrivateData(*key, &size, value);
+#else
+    HRESULT result = object->lpVtbl->GetPrivateData(object, key, &size, value);
+#endif
+    if (FAILED(result)) {
+        *value = NULL;
+        return result;
+    }
+    if (size != sizeof(*value)) {
+        *value = NULL;
+        return E_INVALIDARG;
+    }
+    return result;
+}
